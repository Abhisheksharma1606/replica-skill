# Copy to .env and fill in. Leave DRY_RUN=true until every key below is set and tested.
DRY_RUN=true
AGENCY_NAME=Northstar Ads
PUBLIC_BASE_URL=https://agent.youragency.com
DEFAULT_CURRENCY=INR

# Claude (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=
AGENCY_MODEL=claude-opus-5-5
BRAIN_EFFORT=medium
SPECIALIST_EFFORT=high

# State and memory (empty = in-memory, fine for local runs)
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://agency:agency@postgres:5432/agency
VOYAGE_API_KEY=

# WhatsApp Business (Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Voice AI platform -> POST /webhooks/voice with header X-Voice-Secret
VOICE_WEBHOOK_SECRET=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ad account access
LEADSIE_CONNECT_URL=
LEADSIE_WEBHOOK_SECRET=

# Ad platforms (your agency's system user / app tokens)
META_ACCESS_TOKEN=
META_API_VERSION=v21.0
META_PAGE_ID=
TIKTOK_ACCESS_TOKEN=

# Slack human-in-the-loop gate
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=#ad-approvals
SLACK_APPROVER_IDS=
APPROVAL_TTL_HOURS=48

# Shared secret for cron / n8n / Temporal calling /jobs/*
JOBS_TOKEN=
